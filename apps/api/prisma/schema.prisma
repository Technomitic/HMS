generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========================================
// USER & AUTH
// ========================================
model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique @db.VarChar(255)
  phone         String?   @db.VarChar(20)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  firstName     String    @map("first_name") @db.VarChar(100)
  lastName      String    @map("last_name") @db.VarChar(100)
  role          UserRole  @default(PATIENT)
  avatarUrl     String?   @map("avatar_url") @db.VarChar(500)
  isActive      Boolean   @default(true) @map("is_active")
  emailVerified Boolean   @default(false) @map("email_verified")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  patient         Patient?
  doctorProfile   DoctorProfile?
  doctorAppts     Appointment[]    @relation("DoctorAppointments")
  labOrdersCreated LabReport[]     @relation("OrderedBy")
  notifications   Notification[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
  @@map("users")
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
  RECEPTIONIST
  LAB_TECH
  PHARMACIST

  @@map("user_role")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ========================================
// PATIENT
// ========================================
model Patient {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @map("user_id") @db.Uuid
  mrn              String   @unique @db.VarChar(20)
  dateOfBirth      DateTime @map("date_of_birth") @db.Date
  gender           Gender
  bloodGroup       String?  @map("blood_group") @db.VarChar(5)
  allergies        String[] @default([])
  emergencyName    String?  @map("emergency_name") @db.VarChar(100)
  emergencyPhone   String?  @map("emergency_phone") @db.VarChar(20)
  emergencyRelation String? @map("emergency_relation") @db.VarChar(50)
  addressLine1     String?  @map("address_line1") @db.VarChar(255)
  addressLine2     String?  @map("address_line2") @db.VarChar(255)
  city             String?  @db.VarChar(100)
  state            String?  @db.VarChar(100)
  zipCode          String?  @map("zip_code") @db.VarChar(20)
  country          String?  @default("US") @db.VarChar(5)
  insuranceProvider String? @map("insurance_provider") @db.VarChar(200)
  insurancePolicyNo String? @map("insurance_policy_no") @db.VarChar(100)
  consentSigned    Boolean  @default(false) @map("consent_signed")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz

  user         User          @relation(fields: [userId], references: [id])
  appointments Appointment[]
  labReports   LabReport[]
  invoices     Invoice[]

  @@index([mrn])
  @@map("patients")
}

enum Gender {
  MALE
  FEMALE
  OTHER

  @@map("gender")
}

// ========================================
// DOCTOR PROFILE
// ========================================
model DoctorProfile {
  id              String     @id @default(uuid()) @db.Uuid
  userId          String     @unique @map("user_id") @db.Uuid
  department      Department
  specialization  String     @db.VarChar(200)
  licenseNumber   String     @unique @map("license_number") @db.VarChar(50)
  qualifications  String[]   @default([])
  experienceYears Int        @default(0) @map("experience_years")
  consultationFee Int        @default(0) @map("consultation_fee_cents")
  bio             String?    @db.Text
  schedule        Json?      @default("{}") @db.JsonB
  isAvailable     Boolean    @default(true) @map("is_available")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([department])
  @@map("doctor_profiles")
}

enum Department {
  CARDIOLOGY
  ORTHOPEDICS
  PEDIATRICS
  NEUROLOGY
  DERMATOLOGY
  GENERAL_MEDICINE
  EMERGENCY
  RADIOLOGY
  PATHOLOGY
  OPHTHALMOLOGY

  @@map("department")
}

// ========================================
// APPOINTMENTS
// ========================================
model Appointment {
  id              String            @id @default(uuid()) @db.Uuid
  patientId       String            @map("patient_id") @db.Uuid
  doctorId        String            @map("doctor_id") @db.Uuid
  department      Department
  slotStart       DateTime          @map("slot_start") @db.Timestamptz
  slotEnd         DateTime          @map("slot_end") @db.Timestamptz
  status          AppointmentStatus @default(SCHEDULED)
  type            AppointmentType   @default(OPD)
  qrCodeHash      String?           @unique @map("qr_code_hash") @db.VarChar(64)
  chiefComplaint  String?           @map("chief_complaint") @db.Text
  notes           String?           @db.Text
  diagnosis       String?           @db.Text
  vitals          Json?             @db.JsonB
  prescription    Json?             @db.JsonB
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  // CORRECTED RELATIONS:
  patient    Patient     @relation(fields: [patientId], references: [id])
  doctor     User        @relation("DoctorAppointments", fields: [doctorId], references: [id])
  labReports LabReport[]
  invoices   Invoice[]

  @@index([patientId])
  @@index([doctorId])
  @@index([slotStart])
  @@index([status])
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentType {
  OPD
  IPD
  FOLLOW_UP
  EMERGENCY

  @@map("appointment_type")
}

// ========================================
// LAB REPORTS
// ========================================
model LabReport {
  id            String          @id @default(uuid()) @db.Uuid
  appointmentId String          @map("appointment_id") @db.Uuid
  patientId     String          @map("patient_id") @db.Uuid
  orderedBy     String          @map("ordered_by") @db.Uuid
  testType      String          @map("test_type") @db.VarChar(200)
  testCategory  TestCategory    @map("test_category")
  status        LabReportStatus @default(ORDERED)
  results       Json?           @db.JsonB
  reportPdfUrl  String?         @map("report_pdf_url") @db.VarChar(500)
  notes         String?         @db.Text
  completedAt   DateTime?       @map("completed_at") @db.Timestamptz
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])
  orderedByUser User      @relation("OrderedBy", fields: [orderedBy], references: [id])

  @@index([patientId])
  @@index([appointmentId])
  @@index([status])
  @@map("lab_reports")
}

enum TestCategory {
  PATHOLOGY
  RADIOLOGY
  MICROBIOLOGY

  @@map("test_category")
}

enum LabReportStatus {
  ORDERED
  SAMPLE_COLLECTED
  PROCESSING
  COMPLETED
  REJECTED

  @@map("lab_report_status")
}

// ========================================
// BILLING
// ========================================
model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  appointmentId  String        @map("appointment_id") @db.Uuid
  patientId      String        @map("patient_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number") @db.VarChar(30)
  items          Json          @db.JsonB
  subtotalCents  Int           @map("subtotal_cents")
  taxCents       Int           @default(0) @map("tax_cents")
  discountCents  Int           @default(0) @map("discount_cents")
  totalCents     Int           @map("total_cents")
  status         InvoiceStatus @default(UNPAID)
  dueDate        DateTime      @map("due_date") @db.Date
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  paymentMethod  String?       @map("payment_method") @db.VarChar(50)
  pdfUrl         String?       @map("pdf_url") @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  patient     Patient     @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([status])
  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  UNPAID
  PAID
  PARTIALLY_PAID
  REFUNDED
  VOID

  @@map("invoice_status")
}

// ========================================
// NOTIFICATIONS
// ========================================
model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  userId      String              @map("user_id") @db.Uuid
  channel     NotificationChannel
  title       String              @db.VarChar(200)
  body        String              @db.Text
  data        Json?               @db.JsonB
  isRead      Boolean             @default(false) @map("is_read")
  sentAt      DateTime?           @map("sent_at") @db.Timestamptz
  deliveredAt DateTime?           @map("delivered_at") @db.Timestamptz
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

enum NotificationChannel {
  SMS
  EMAIL
  PUSH
  IN_APP

  @@map("notification_channel")
}

// ========================================
// AUDIT LOGS
// ========================================
model AuditLog {
  id           BigInt   @id @default(autoincrement())
  userId       String   @map("user_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String   @map("resource_type") @db.VarChar(50)
  resourceId   String   @map("resource_id") @db.Uuid
  changes      Json?    @db.JsonB
  ipAddress    String   @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}