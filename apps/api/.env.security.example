# ====================================
# SECURITY CONFIGURATION
# ====================================

# JWT Configuration
JWT_SECRET=change-this-to-a-secure-random-string-minimum-64-chars-long-abc123def456ghi789
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption (generate with: openssl rand -hex 32)
ENCRYPTION_MASTER_KEY=your-256-bit-hex-encoded-key-here-generate-with-openssl-rand
HASH_PEPPER=your-unique-hash-pepper-for-deterministic-hashing

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# CORS
CORS_ORIGINS=https://medix.hospital,https://app.medix.hospital

# Admin IP Whitelist (comma-separated, leave empty to disable)
ADMIN_WHITELIST_IPS=

# Session Management
MAX_SESSIONS_PER_USER=5
SESSION_TTL_SECONDS=86400

# Brute Force Protection
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_WINDOW_SECONDS=300
BRUTE_FORCE_BLOCK_SECONDS=900

# Database Encryption (AWS KMS)
# AWS_KMS_KEY_ID=arn:aws:kms:us-east-1:123456789:key/your-key-id

# Twilio (HIPAA-compliant tier required)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid
SENDGRID_API_KEY=

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# S3 (for encrypted document storage)
AWS_S3_BUCKET=medix-prod-reports
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=